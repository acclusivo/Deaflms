# DeafLMS — Supabase Authentication & Storage Environment Configuration
# To connect your live Supabase project, copy this file to .env.local:
# cp .env.local.example .env.local

# 1. Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon / Public Key (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note:
# When these keys are present in .env.local, DeafLMS automatically switches to live Supabase Auth.
# When these keys are absent, DeafLMS operates seamlessly in local verified mode with zero external network dependencies.
