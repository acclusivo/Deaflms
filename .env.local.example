# DeafLMS — Supabase Authentication & Storage Environment Configuration
# To connect your live Supabase project, copy this file to .env.local:
# cp .env.local.example .env.local

# 1. Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon / Public Key (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note:
# When these keys are present in .env.local, DeafLMS automatically switches to live Supabase Auth.
# When these keys are absent, DeafLMS operates seamlessly in local verified mode with zero external network dependencies.

# ==============================================================================
# DeafLMS — Sanity CMS Educational Content Configuration
# ==============================================================================
# 3. Sanity Project ID (From sanity.io/manage -> Project Settings)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id

# 4. Sanity Dataset (Default: production)
NEXT_PUBLIC_SANITY_DATASET=production

# 5. Sanity API Version (ISO Date e.g. 2024-11-01)
NEXT_PUBLIC_SANITY_API_VERSION=2024-11-01

# 6. Sanity Server-Side Tokens (NEVER prefix with NEXT_PUBLIC_)
# For server-side preview of draft educational content:
SANITY_API_READ_TOKEN=skYourServerSideReadTokenHere

# For server-side content updates and migrations (NEVER expose to frontend):
# SANITY_API_WRITE_TOKEN=skYourServerSideWriteTokenHere

# ==============================================================================
# DeafLMS — Selar Hosted Product Links (Live Payment Gateway)
# ==============================================================================
# Optional: Set your live Selar product links created on https://selar.co
# When provided, checkout allows redirecting to your hosted Selar checkout page.
# When omitted, DeafLMS utilizes direct automated webhook activation for instant 5-second enrolment.
# NEXT_PUBLIC_SELAR_COURSE_WEB_DEV_URL=https://selar.co/m/deaflms-webdev
# NEXT_PUBLIC_SELAR_COURSE_HEARING_NSL_URL=https://selar.co/m/deaflms-hearing-allies
# NEXT_PUBLIC_SELAR_STORE_URL=https://selar.co/m/deaflms

